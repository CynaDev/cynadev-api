{# templates/invoice/invoice.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      font-size: 13px;
      color: #333;
      padding: 40px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 40px;
      border-bottom: 2px solid #7c3aed;
      padding-bottom: 20px;
    }

    .company-name {
      font-size: 24px;
      font-weight: bold;
      color: #7c3aed;
    }

    .invoice-title { text-align: right; }
    .invoice-title h1 { font-size: 28px; color: #7c3aed; margin-bottom: 4px; }
    .invoice-title p { color: #666; font-size: 12px; }

    .meta {
      display: flex;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .meta-block h3 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #999;
      margin-bottom: 6px;
    }

    .meta-block p { font-size: 13px; color: #333; line-height: 1.6; }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }

    .badge-En_Attente { background: #fef9c3; color: #a16207; }
    .badge-Payee      { background: #dcfce7; color: #15803d; }
    .badge-Expediee   { background: #dbeafe; color: #1d4ed8; }
    .badge-Annulee    { background: #fee2e2; color: #dc2626; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }

    thead tr { background: #7c3aed; color: white; }
    thead th { padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 600; }

    tbody tr:nth-child(even) { background: #f9f7ff; }
    tbody td { padding: 10px 12px; border-bottom: 1px solid #e9e7f0; }

    .text-right { text-align: right; }

    .totals { margin-left: auto; width: 260px; }
    .totals table { margin-bottom: 0; }
    .totals td { padding: 6px 12px; border: none; }
    .totals tr:last-child { background: #7c3aed; color: white; font-weight: bold; font-size: 14px; }
    .totals tr:last-child td { padding: 10px 12px; }

    .footer {
      margin-top: 48px;
      padding-top: 16px;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      font-size: 11px;
      color: #999;
    }
  </style>
</head>
<body>

  <!-- En-tête -->
  <div class="header">
    <div>
      <p class="company-name">Cyna</p>
      <p style="color:#666; font-size:12px; margin-top:4px;">contact@cyna.fr</p>
    </div>
    <div class="invoice-title">
      <h1>FACTURE</h1>
      <p>#{{ order.id }}</p>
      <p>{{ order.dateCommande|date('d/m/Y') }}</p>
    </div>
  </div>

  <!-- Méta infos -->
  <div class="meta">
    <div class="meta-block">
      <h3>Commande</h3>
      <p>#{{ order.id }}</p>
      <p>{{ order.dateCommande|date('d/m/Y') }}</p>
    </div>

    <div class="meta-block">
      <h3>Statut</h3>
      {% set labels = {
        'En_Attente': 'En attente',
        'Payee':      'Payée',
        'Expediee':   'Expédiée',
        'Annulee':    'Annulée'
      } %}
      <span class="badge badge-{{ order.status.value }}">
        {{ labels[order.status.value] ?? order.status.value }}
      </span>
    </div>

    {% if order.user is defined and order.user %}
    <div class="meta-block">
      <h3>Client</h3>
      <p>{{ order.user.firstname ?? '' }} {{ order.user.lastname ?? '' }}</p>
      <p>{{ order.user.email ?? '' }}</p>
    </div>
    {% endif %}
  </div>

  <!-- Tableau des produits -->
  <table>
    <thead>
      <tr>
        <th>Produit</th>
        <th class="text-right">Quantité</th>
        <th class="text-right">Prix unitaire</th>
        <th class="text-right">Sous-total</th>
      </tr>
    </thead>
    <tbody>
      {% for item in order.orderItems %}
      <tr>
        <td>{{ item.product.name }}</td>
        <td class="text-right">{{ item.quantity }}</td>
        <td class="text-right">{{ item.price|number_format(2, ',', ' ') }} €</td>
        <td class="text-right">
          {{ (item.price * item.quantity)|number_format(2, ',', ' ') }} €
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- Totaux -->
  <div class="totals">
    <table>
      <tr>
        <td>Total HT</td>
        <td class="text-right">{{ order.totalHt|number_format(2, ',', ' ') }} €</td>
      </tr>
      <tr>
        <td>TVA (20%)</td>
        <td class="text-right">
          {{ (order.totalTtc - order.totalHt)|number_format(2, ',', ' ') }} €
        </td>
      </tr>
      <tr>
        <td>Total TTC</td>
        <td class="text-right">{{ order.totalTtc|number_format(2, ',', ' ') }} €</td>
      </tr>
    </table>
  </div>

  <!-- Footer -->
  <div class="footer">
    <p>Cyna — Merci pour votre confiance.</p>
    <p>Ce document est généré automatiquement et constitue votre facture officielle.</p>
  </div>

</body>
</html>